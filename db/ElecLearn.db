-- Schéma SQL pour ElecLearn.db (Version post-reset)

-- Fascicules: Peut être gardée pour une éventuelle organisation future,
-- ou pour lier les chapitres à une entité parente même si non utilisée pour la navigation directe.
CREATE TABLE Fascicules (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    titre TEXT NOT NULL UNIQUE,
    description TEXT
);

-- Chapitres: Contient les 15 chapitres principaux (fiches).
-- Le fascicule_id peut pointer vers un ID de la table Fascicules par convention (ex: 1).
CREATE TABLE Chapitres (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    fascicule_id INTEGER, -- Peut être NULL ou pointer vers un fascicule "général"
    numero_chapitre INTEGER NOT NULL, -- Pour l'ordre d'affichage du sommaire principal
    titre TEXT NOT NULL,
    contenu_path TEXT NOT NULL,
    FOREIGN KEY (fascicule_id) REFERENCES Fascicules(id) ON DELETE SET NULL -- Si fascicule est supprimé, met à NULL ici
);

-- Questions: Stocke les questions des quiz
CREATE TABLE Questions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    chapitre_id INTEGER NOT NULL, -- Lié à un des 15 chapitres principaux
    texte_question TEXT NOT NULL,
    type_question TEXT NOT NULL DEFAULT 'QCM', -- 'QCM', 'VRAI_FAUX', 'REPONSE_COURTE' (seul QCM géré pour l'instant)
    explication TEXT,
    FOREIGN KEY (chapitre_id) REFERENCES Chapitres(id) ON DELETE CASCADE -- Si chapitre supprimé, questions aussi
);

-- OptionsReponses: Stocke les options pour les questions QCM
CREATE TABLE OptionsReponses (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    question_id INTEGER NOT NULL,
    texte_option TEXT NOT NULL,
    est_correcte BOOLEAN NOT NULL DEFAULT 0,
    FOREIGN KEY (question_id) REFERENCES Questions(id) ON DELETE CASCADE -- Si question supprimée, options aussi
);

-- Glossaire: Termes techniques et leurs définitions
CREATE TABLE Glossaire (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    terme TEXT NOT NULL UNIQUE,
    definition TEXT NOT NULL,
    chapitre_id INTEGER, -- Optionnel: lier un terme à un chapitre spécifique
    FOREIGN KEY (chapitre_id) REFERENCES Chapitres(id) ON DELETE SET NULL
);

-- ResultatsQuiz: Enregistre les tentatives de quiz.
-- Ajout de la colonne type_quiz.
CREATE TABLE ResultatsQuiz (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    chapitre_id INTEGER, -- NULL pour les quiz généraux, sinon ID du chapitre
    score INTEGER NOT NULL,
    total_questions INTEGER NOT NULL,
    type_quiz TEXT NOT NULL DEFAULT 'chapitre', -- 'chapitre' ou 'general'
    date_tentative DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (chapitre_id) REFERENCES Chapitres(id) ON DELETE SET NULL
    -- Si un chapitre est supprimé, on garde le résultat mais sans lien chapitre,
    -- ou ON DELETE CASCADE si on veut supprimer les résultats associés. SET NULL est plus prudent.
);

-- Index pour améliorer les performances
CREATE INDEX idx_chapitres_fascicule_id ON Chapitres(fascicule_id);
CREATE INDEX idx_questions_chapitre_id ON Questions(chapitre_id);
CREATE INDEX idx_options_question_id ON OptionsReponses(question_id);
CREATE INDEX idx_glossaire_chapitre_id ON Glossaire(chapitre_id);
CREATE INDEX idx_resultats_chapitre_id ON ResultatsQuiz(chapitre_id);
CREATE INDEX idx_resultats_type_quiz ON ResultatsQuiz(type_quiz);


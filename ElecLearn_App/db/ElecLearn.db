-- Schéma SQL pour ElecLearn.db
-- Ce fichier sera utilisé par sql.js pour initialiser la base de données.
-- Vous pouvez le remplir avec les commandes CREATE TABLE et éventuellement des INSERTs initiaux.

-- Fascicules: Contient la liste des fascicules
CREATE TABLE Fascicules (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    titre TEXT NOT NULL UNIQUE,
    description TEXT
);

-- Chapitres: Contient les chapitres de chaque fascicule
CREATE TABLE Chapitres (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    fascicule_id INTEGER NOT NULL,
    numero_chapitre INTEGER NOT NULL, -- Pour l'ordre
    titre TEXT NOT NULL,
    contenu_path TEXT, -- Chemin vers un fichier HTML de contenu, ou NULL (pour l'instant, peut-être du texte direct)
    FOREIGN KEY (fascicule_id) REFERENCES Fascicules(id)
);

-- Questions: Stocke les questions des quiz
CREATE TABLE Questions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    chapitre_id INTEGER NOT NULL,
    texte_question TEXT NOT NULL,
    type_question TEXT NOT NULL DEFAULT 'QCM', -- 'QCM', 'VRAI_FAUX', 'REPONSE_COURTE'
    explication TEXT, -- Explication affichée après la réponse
    FOREIGN KEY (chapitre_id) REFERENCES Chapitres(id)
);

-- OptionsReponses: Stocke les options pour les questions à choix multiples (QCM)
CREATE TABLE OptionsReponses (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    question_id INTEGER NOT NULL,
    texte_option TEXT NOT NULL,
    est_correcte BOOLEAN NOT NULL DEFAULT 0, -- 0 pour faux, 1 pour vrai
    FOREIGN KEY (question_id) REFERENCES Questions(id)
);

-- Glossaire: Termes techniques et leurs définitions
CREATE TABLE Glossaire (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    terme TEXT NOT NULL UNIQUE,
    definition TEXT NOT NULL,
    chapitre_id INTEGER, -- Optionnel: lier un terme à un chapitre spécifique
    FOREIGN KEY (chapitre_id) REFERENCES Chapitres(id)
);

-- ResultatsQuiz: Enregistre les tentatives de quiz par l'utilisateur
CREATE TABLE ResultatsQuiz (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    chapitre_id INTEGER NOT NULL,
    score INTEGER NOT NULL,
    total_questions INTEGER NOT NULL,
    date_tentative DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (chapitre_id) REFERENCES Chapitres(id)
);

-- Index pour améliorer les performances des requêtes courantes
CREATE INDEX idx_chapitres_fascicule_id ON Chapitres(fascicule_id);
CREATE INDEX idx_questions_chapitre_id ON Questions(chapitre_id);
CREATE INDEX idx_options_question_id ON OptionsReponses(question_id);
CREATE INDEX idx_glossaire_chapitre_id ON Glossaire(chapitre_id);
CREATE INDEX idx_resultats_chapitre_id ON ResultatsQuiz(chapitre_id);

